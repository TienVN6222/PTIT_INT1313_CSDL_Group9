LEG [shape=none, fontsize=14, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
<TR><TD ALIGN="LEFT"><B>Legend</B></TD></TR>
<TR><TD ALIGN="LEFT">Rectangle = entity type; diamond = relationship type; oval = attribute</TD></TR>
<TR><TD ALIGN="LEFT"><U>Underlined</U> = key attribute; dashed oval = derived attribute</TD></TR>
<TR><TD ALIGN="LEFT">Double line = total participation; single line = partial participation</TD></TR>
<TR><TD ALIGN="LEFT">1 / N / M = cardinality ratio</TD></TR>
<TR><TD ALIGN="LEFT">Circle "o" = overlapping specialization; ⊂ = subclass of USER_ACCOUNT</TD></TR>
<TR><TD ALIGN="LEFT">XOR = exclusive arc (a reservation is for a booking OR a class)</TD></TR>
<TR><TD ALIGN="LEFT">Only key and main attributes shown; full list in 2_conceptual.md</TD></TR></TABLE>>, pos="-23.00,-3.00!"];
}