# Cấu hình Mẫu CSDL PostgreSQL cho Hệ thống Quản lý Gym
POSTGRES_DB=gym_management
POSTGRES_USER=gym_admin
POSTGRES_PASSWORD=gym_password_2026
POSTGRES_PORT=5432

# Tài khoản ứng dụng web (KHÔNG phải superuser; nhóm quyền gym_role_admin, xem Phase 3/08_rbac_security.sql).
# POSTGRES_USER ở trên chỉ dùng để khởi tạo CSDL (initdb).
DB_USER=gym_u_admin
DB_PASSWORD=demo_2026

# Bộ lập lịch gia hạn hợp đồng (service `scheduler`, BR-24): số giây giữa 2 lần gọi
# sp_process_subscription_renewals(). Mặc định 86400 (1 ngày); đặt nhỏ (ví dụ 20) để trình diễn.
RENEWAL_INTERVAL_SECONDS=86400
# Tài khoản scheduler dùng (lễ tân, có EXECUTE thủ tục gia hạn; không phải superuser).
SCHEDULER_DB_USER=gym_u_reception
SCHEDULER_DB_PASSWORD=demo_2026
# BR-23: user_id của người thực hiện được ghi vào created_by_user_id/updated_by_user_id khi scheduler gọi thủ tục gia hạn (mặc định 3 = lễ tân)
SCHEDULER_ACTOR_USER_ID=3

# Sao lưu định kỳ có mã hóa (service `backup`, NFR-AVL-01 / NFR-SEC-03).
# BẮT BUỘC đổi BACKUP_PASSPHRASE khi triển khai thật và cất giữ an toàn: mất mật khẩu = không khôi phục được.
BACKUP_PASSPHRASE=doi_mat_khau_sao_luu_khi_trien_khai
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=7
WAL_ARCHIVE_TIMEOUT=300

# pgAdmin 4 (service `pgadmin`, cổng 5050): tài khoản đăng nhập giao diện web pgAdmin.
PGADMIN_EMAIL=admin@fitzone.com
PGADMIN_PASSWORD=pgadmin_g9_2026
PGADMIN_PORT=5050
